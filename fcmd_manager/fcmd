givepermissions(){
  opsi=$1; run=$2; clear
  echo -e "\n [ pilih perizinan file ($2) ]\n"
  win 1
  echo -e "\n[ Detail ]\n     |__ [r=izin baca] [w=izin tulis] [x=izin eksekusi bash]\n\n"
  read -p "--> " gopsi
  case $gopsi in
    '0') chmod $opsi+r $run
         tabel "file ($run) berhasil diberi izin baca(+r)";;
    '1') chmod $opsi+w $run
         tabel "file ($run) berhasil diberi izin tulis(+w)";;
    '2') chmod $opsi+x $run
         tabel "file ($run) berhasil diberi izin eksekusi(+x)";;
    '3') chmod $opsi+rw $run
         tabel "file ($run) berhasil diberi izin baca dan tulis(+rw)";;
    '4') chmod $opsi+rx $run
         tabel "file ($run) berhasil diberi izin.baca dan eksekusi(+rx)";;
    '5') chmod $opsi+wx $run
         tabel "file ($run) berhasil diberi izin tulis dan eksekusi(+wx)";;
    '6') chmod $opsi+rwx $run
         tabel "file ($run) berhasil diberi izin baca, tulis dan eksekusi(+rwx)";;
    '7') chmod $opsi-r $run
         tabel "file ($run) berhasil dicopot izin baca(-r)";;
    '8') chmod $opsi-w $run
         tabel "file ($run) berhasil dicopot izin tulis(-w)";;
    '9') chmod $opsi-x $run
         tabel "file ($run) berhasil dicopot izin eksekusi(-x)";;
    '10') chmod $opsi-rw $run
         tabel "file ($run) berhasil dicopot izin baca dan tulis(-rw)";;
    '11') chmod $opsi-rx $run
         tabel "file ($run) berhasil dicopot izin baca dan eksekusi(-rx)";;
    '12') chmod $opsi-wx $run
         tabel "file ($run) berhasil dicopot izin tulis dan eksekusi(-wx)";;
    '13') chmod $opsi-rwx $run
         tabel "file ($run) berhasil dicopot izin baca, tulis dan eksekusi(-rwx)";;
      *) tabel "pilih angka opsi yang tersedia";;
  esac
}

#get opsi permissions
getopsi(){
  tabel "pilih jenis perizinan untuk file ($1)"
  echo -e "\n [a]all [u]user [g]group [o]other"
  echo; read -p "--> " opsi
  case $opsi in
    'a') givepermissions "a" $1;;
    'u') givepermissions "u" $1;;
    'g') givepermissions "g" $1;;
    'o') givepermissions "o" $1;;
      *) tabel "pilih huruf file yang tersedia";;
  esac
}

#method get permissions file
gpermissionsf(){
  tabel "file yang akan diberi izin"
  echo -e "\n [ PERMISSIONS ]\n     |__ [drwx_rwx_rwx=all] [drwx=user] [rwx=grub] [rwx=other]"
  move me file angka
  if [[ $me == $angka ]];then
