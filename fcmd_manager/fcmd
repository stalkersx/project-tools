#fungsi beri hak pemilikan file
give_owner(){
  # owner in system
  if [ -f /etc/passwd ];then
    # array user group
    arru=( $(cat /etc/passwd | cut -d ':' -f 1) )

    # tabel list user group
    echo -e "\n [ pilih pemilik file ]\n"
    winopen
    for uo2 in ${!arru[@]};do
      gettext "$uo2. ${arru[uo2]}" 2
    done
    winclose

    # choose user group
    echo; read -p "--> " opsi_uo
    for uo1 in ${!arru[@]};do
      if [[ $opsi_uo == $uo1 ]];then
        owner_new=${arru[uo1]}
      fi
    done

    # give onwer
    if [[ $1 == "user" ]] && [ "$owner_new" ];then
      if [[ $owner_new == "$(ls -ld $2 | awk '{print $3}')" ]];then
        tabel "$1 file ($2) saat ini ialah ($owner_new) proses gagal"
      else
        chown $owner_new $2
	tabel "$1 file ($2) berhasil diganti ke ($owner_new)"
      fi
    elif [[ $1 == "group" ]] && [ "$owner_new" ];then
      if [[ $owner_new == "$(ls -ld $2 | awk '{print $4}')" ]];then
        tabel "$1 file ($2) saat ini ialah ($owner_new) proses gagal"
      else
        chown :$owner_new $2
	tabel "$1 file ($2) berhasil diganti ke ($owner_new)"
      fi
    elif [[ $1 == "all" ]] && [ "$owner_new" ];then
      chown $owner_new:$owner_new $2
      tabel "user dan group file ($2) berhasil diganti ke ($owner_new)"
    else
      tabel "pilih pemilik file yang tersedia"
    fi
  else
    tabel "proses gagal (/etc/passwd) not found"
  fi
  unset owner_new
}

#fungsi pemilik file
ownerfile(){
  tabel "file yang akan diubah pemilikan"
  move me file angka
  if [[ $me == $angka ]];then
    if [[ $(whoami) == "root" ]];then
      tabel "pilih jenis pemilik file ($file)"
      echo -e "\n [a]all [u]user [g]group"
      echo; read -p "--> " opsi1
      if [[ $opsi1 == "a" ]];then
        give_owner "all" $file
      elif [[ $opsi1 == "u" ]];then
        give_owner "user" $file
      elif [[ $opsi1 == "g" ]];then
        give_owner "group" $file
      else
         tabel "pilih opsi yang tersedia proses gagal"
      fi
    else
      tabel "proses gagal butuh perizinan root"
    fi
  else
    tabel "pilih angka yang tersedia"
  fi
}

