#fungsi tampilkan detail file
detailfile(){
  tabel "file mana yang akan ditampilkan detail"
  move me file angka
  if [[ $me == $angka ]] && ! [ -r $file ];then
    tabel "tidak ada izin baca(r) di file ($file)"
  elif [[ $me == $angka ]] && [ -r $file ];then
    tabel_df $file
  else
    tabel "pilih angka untuk tampilkan detail file"
  fi
}

# input text file manager
file_managerx(){
	skipd="$1"
	warna="\e[47;30m"
	#echo -e $warna
	tabel "File Manager"
	while [ true ];do
		echo -e "\n [b]buat [e]edit  [h]hapus  [m]pindah [k]kembali [i]perizinan\n [r]ubah [c]salin [p]lokasi [d]detail [q]keluar  [w]pemilik"
		move me file angka
		if [ -z $me ];then
			tabel "input kosong"
		elif [[ $me == $angka ]] && ! [ -w $file ];then
			tabel "tidak ada izin tulis(w) di file ($file)"
		elif [[ $me == $angka ]] && ! [ -r $file ];then
			tabel "tidak ada izin baca(r) di file ($file)"
		elif [[ $me == $angka ]] && [ -d $file ] && [ -x $file ];then
			cd $file; tabel "membuka ($file)"
		elif [[ $me == $angka ]] && [ -f $file ];then
			less $file; tabel "membaca ($file)"
		elif [[ $me == 'b' ]];then newfile
		elif [[ $me == 'c' ]];then cmhfile "copy" 1
		elif [[ $me == 'm' ]];then cmhfile "pindahkan" 2
		elif [[ $me == 'h' ]];then cmhfile "hapus" 3 "null"
		elif [[ $me == 'r' ]];then renamefile
		elif [[ $me == 'w' ]];then ownerfile
		elif [[ $me == 'd' ]];then detailfile
		elif [[ $me == 'i' ]];then gpermissionsf
		elif [[ $me == 'p' ]];then tabel "menampilkan lokasi path anda berada"; echo -e "\n [ PATH ]\n      |_ $(pwd)"
		elif [[ $me == 'k' ]];then phl=$(pwd); cd ..; ph=$(pwd)
			if ! [ -r $ph ];then cd $phl
				tabel "path <$ph> tidak ada izin baca(r)"
				unset phl; unset ph; continue
			fi
			if [[ $phl == $skipd ]];then cd $phl; unset phl; unset ph
				tabel "(q) untuk keluar pengaturan"
				unset phl; unset ph; continue
			fi
			unset phl; unset ph; tabel "kembali"
		elif [[ $me == 'e' ]];then editfile
		elif [[ $me == "q" ]];then exit
		else
			tabel "pilih angka atau huruf yang tersedia"
		fi
	done
}

#end get have is space
IFS=$OLDIFS

############ OPTIONS #################
if [[ $1 == "--help" ]] && [ -z "$2" ];then
	echo -e "\nfcmd [target_directory] [skip_directory]\nfcmd [options] [flags]\n\nOptions\n-f\tfound a file or directory\n-t\tshow a file total of directory"
elif [[ $1 == "-t" ]] && [ -z "$4" ];then
	total_file $2 $3
elif [[ $1 == "-f" ]] && [ -z "$4" ];then
	found_file $2 $3
else
	# parameter
	if [ -z "$1" ];then
		if [ -w $(pwd) ];then
			file_managerx
		else
			echo "! butuh perizinan root ($(pwd))"
		fi
	elif [ "$1" ] && [ -d $1 ];then
		# target directory
		if [ -w $1 ];then cd $1
			# skip directory
			if [ -z $2 ];then
				file_managerx
			elif [ -d "$2" ] && [ -z "$3" ];then
				file_managerx $2
			else
				echo "! tidak diketahui ($2)"
			fi
		else
			echo "! butuh perizinan root ($1)"
		fi
	else
		echo "! tidak diketahui ($1)"
	fi
fi

